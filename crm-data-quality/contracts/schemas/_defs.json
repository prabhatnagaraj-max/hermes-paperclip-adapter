{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crm-dq/_defs.json",
  "title": "CRM-DQ Shared Definitions",
  "type": "object",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "dateTimeUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "scanRunStatus": {"type": "string", "enum": ["running", "completed", "failed", "cancelled"]},
    "entityLogicalName": {"type": "string", "enum": ["account", "contact", "lead", "opportunity"]},
    "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
    "ruleStatus": {"type": "string", "enum": ["pass", "warn", "fail", "skip"]},
    "piiPolicyTag": {"type": "string", "enum": ["none", "masked", "restricted"]},
    "scoreBand": {"type": "string", "enum": ["excellent", "good", "fair", "poor", "critical"]},
    "publishDestination": {"type": "string", "enum": ["dataverse", "lakehouse", "queue"]},
    "publishStatus": {"type": "string", "enum": ["pending", "succeeded", "failed", "dead_lettered"]}
  }
}
