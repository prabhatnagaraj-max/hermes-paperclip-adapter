{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crm-dq/dq-publish-event.json",
  "title": "DQ_PUBLISH_EVENT",
  "type": "object",
  "additionalProperties": false,
  "required": ["publish_event_id","scan_run_id","destination","publish_status","attempt_count"],
  "properties": {
    "publish_event_id": {"$ref": "_defs.json#/$defs/uuid"},
    "scan_run_id": {"$ref": "_defs.json#/$defs/uuid"},
    "snapshot_id": {"$ref": "_defs.json#/$defs/uuid"},
    "destination": {"$ref": "_defs.json#/$defs/publishDestination"},
    "destination_record_id": {"type": "string", "minLength": 1},
    "publish_status": {"$ref": "_defs.json#/$defs/publishStatus"},
    "attempt_count": {"type": "integer", "minimum": 1},
    "published_at_utc": {"$ref": "_defs.json#/$defs/dateTimeUtc"},
    "error_code": {"type": "string", "maxLength": 128},
    "error_message": {"type": "string", "maxLength": 1000}
  }
}
