{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crm-dq/extract-request.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_env", "correlation_id", "entity_logical_names"],
  "properties": {
    "source_env": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "entity_logical_names": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "_defs.json#/$defs/entityLogicalName"}
    }
  }
}
