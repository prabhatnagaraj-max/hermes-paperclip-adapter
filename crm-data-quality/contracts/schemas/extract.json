{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extract.json",
  "type": "object",
  "required": ["contract_version", "operation", "correlation_id", "request", "response"],
  "properties": {
    "contract_version": { "$ref": "common.json#/$defs/contractVersion" },
    "operation": { "const": "extract" },
    "correlation_id": { "type": "string", "minLength": 1 },
    "request": {
      "type": "object",
      "required": ["scan_run_id", "source_env", "entity_logical_names", "watermark_from_utc"],
      "properties": {
        "scan_run_id": { "$ref": "common.json#/$defs/uuid" },
        "source_env": { "type": "string", "minLength": 1 },
        "entity_logical_names": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.json#/$defs/entityLogicalName" },
          "uniqueItems": true
        },
        "watermark_from_utc": { "$ref": "common.json#/$defs/utcDateTime" },
        "watermark_to_utc": { "$ref": "common.json#/$defs/utcDateTime" },
        "max_page_size": { "type": "integer", "minimum": 1, "maximum": 5000 }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["success", "error"] },
        "scan_run": { "$ref": "common.json#/$defs/dqScanRun" },
        "entity_snapshots": {
          "type": "array",
          "items": { "$ref": "common.json#/$defs/dqEntitySnapshot" }
        },
        "error": { "$ref": "error-response.json#/properties/error" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "success" } } },
          "then": {
            "required": ["scan_run", "entity_snapshots"],
            "not": { "required": ["error"] }
          }
        },
        {
          "if": { "properties": { "status": { "const": "error" } } },
          "then": {
            "required": ["error"],
            "not": {
              "anyOf": [
                { "required": ["scan_run"] },
                { "required": ["entity_snapshots"] }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
