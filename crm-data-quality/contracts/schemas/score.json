{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "score.json",
  "type": "object",
  "required": ["contract_version", "operation", "correlation_id", "request", "response"],
  "properties": {
    "contract_version": { "$ref": "common.json#/$defs/contractVersion" },
    "operation": { "const": "score" },
    "correlation_id": { "type": "string", "minLength": 1 },
    "request": {
      "type": "object",
      "required": ["scan_run_id", "rule_set_version", "entity_snapshots"],
      "properties": {
        "scan_run_id": { "$ref": "common.json#/$defs/uuid" },
        "rule_set_version": { "type": "string", "minLength": 1 },
        "entity_snapshots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.json#/$defs/dqEntitySnapshot" }
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["success", "error"] },
        "rule_results": {
          "type": "array",
          "items": { "$ref": "common.json#/$defs/dqRuleResult" }
        },
        "score_summary": { "$ref": "common.json#/$defs/dqScoreSummary" },
        "error": { "$ref": "error-response.json#/properties/error" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "success" } } },
          "then": {
            "required": ["rule_results", "score_summary"],
            "not": { "required": ["error"] }
          }
        },
        {
          "if": { "properties": { "status": { "const": "error" } } },
          "then": {
            "required": ["error"],
            "not": {
              "anyOf": [
                { "required": ["rule_results"] },
                { "required": ["score_summary"] }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
