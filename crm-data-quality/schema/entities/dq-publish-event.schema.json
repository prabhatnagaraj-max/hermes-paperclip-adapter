{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crm-dq/schema/entities/dq-publish-event.schema.json",
  "title": "DQ_PUBLISH_EVENT",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publish_event_id",
    "scan_run_id",
    "destination",
    "publish_status",
    "attempt_count"
  ],
  "properties": {
    "publish_event_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "scan_run_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "snapshot_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "destination": { "type": "string", "enum": ["dataverse", "lakehouse", "queue"] },
    "destination_record_id": { "type": "string", "minLength": 1 },
    "publish_status": { "type": "string", "enum": ["pending", "succeeded", "failed", "dead_lettered"] },
    "attempt_count": { "type": "integer", "minimum": 1 },
    "published_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "error_code": { "type": "string", "maxLength": 128 },
    "error_message": { "type": "string", "maxLength": 1000 }
  }
}
