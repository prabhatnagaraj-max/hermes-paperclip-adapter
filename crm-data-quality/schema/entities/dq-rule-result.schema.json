{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crm-dq/schema/entities/dq-rule-result.schema.json",
  "title": "DQ_RULE_RESULT",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_result_id",
    "scan_run_id",
    "snapshot_id",
    "rule_id",
    "rule_version",
    "severity",
    "status",
    "score_impact",
    "reason_code",
    "evaluated_at_utc"
  ],
  "properties": {
    "rule_result_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "scan_run_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "snapshot_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "rule_id": { "type": "string", "minLength": 1 },
    "rule_version": { "type": "string", "minLength": 1 },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
    "status": { "type": "string", "enum": ["pass", "warn", "fail", "skip"] },
    "score_impact": { "type": "number", "minimum": -100, "maximum": 100 },
    "reason_code": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "maxLength": 1000 },
    "evaluated_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pass" } }, "required": ["status"] },
      "then": { "properties": { "score_impact": { "minimum": 0 } } }
    }
  ]
}
