{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crm-dq/schema/entities/dq-scan-run.schema.json",
  "title": "DQ_SCAN_RUN",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scan_run_id",
    "contract_version",
    "source_system",
    "source_env",
    "started_at_utc",
    "status",
    "extracted_entity_count",
    "evaluated_rule_count",
    "correlation_id"
  ],
  "properties": {
    "scan_run_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "contract_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "source_system": { "type": "string", "enum": ["dataverse"] },
    "source_env": { "type": "string", "minLength": 1 },
    "started_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "completed_at_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "status": { "type": "string", "enum": ["running", "completed", "failed", "cancelled"] },
    "extracted_entity_count": { "type": "integer", "minimum": 0 },
    "evaluated_rule_count": { "type": "integer", "minimum": 0 },
    "overall_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "correlation_id": { "type": "string", "minLength": 1 }
  }
}
